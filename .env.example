# Створіть бота через @BotFather і вставте отриманий токен лише у локальний .env.
TELEGRAM_BOT_TOKEN=

# true — запускати Telegram-бота; false — запускати лише локальне API.
BOT_ENABLED=true

# Необов'язково: ID дозволених груп/каналів через кому.
# Порожнє значення дозволяє всі чати, до яких додали бота.
ALLOWED_CHAT_IDS=

# Торгова дата для американських акцій визначається за часом Нью-Йорка.
APP_TIMEZONE=America/New_York
DATABASE_PATH=data/tickers.db

# Звичайні тікери без знака $, наприклад AAPL, теж розпізнаються.
ENABLE_PLAIN_TICKERS=true

# API майбутнього скрінера за замовчуванням доступне лише на цьому комп'ютері.
API_HOST=127.0.0.1
API_PORT=8765

# Додайте довгий випадковий секрет, якщо відкриватимете API назовні.
SCANNER_API_TOKEN=

# Пароль на сторінку сканера, якщо вона доступна через інтернет.
SCANNER_SITE_PASSWORD=
LOG_LEVEL=INFO

